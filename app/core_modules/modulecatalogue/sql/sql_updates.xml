<?xml version='1.0' encoding='ISO-8859-1'?>
<updates>
    <update>
        <table>tbl_module_blocks</table>
        <version>2.031</version>
        <description>Added column for type of block </description>
        <data>
            <add>
                <name>blocktype</name>
                <type>text</type>
                <length>150</length>
                <default>site</default>
            </add>
        </data>
    </update>
    <update>
        <table>tbl_module_patches</table>
        <version>3.120</version>
        <description>Allow patch records for legacy table names up to 64 characters</description>
        <data>
            <change>
                <tablename>
                    <definition>
                        <type>text</type>
                        <length>64</length>
                    </definition>
                </tablename>
            </change>
        </data>
    </update>
</updates>